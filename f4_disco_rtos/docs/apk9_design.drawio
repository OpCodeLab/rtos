<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="APK9 generator" version="24.7.0"><diagram name="System Context" id="System_Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys3" value="APK9 - The PC is the physical world (sensor + 2 actuators), the STM32 is the brain" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="sys4" value="PC  -  tools/apk9_gui.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="520" height="460" as="geometry"/></mxCell><mxCell id="sys5" value="&lt;b&gt;Heater&lt;/b&gt;&lt;br&gt;actuator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="200" height="90" as="geometry"/></mxCell><mxCell id="sys6" value="&lt;b&gt;Relay&lt;/b&gt;&lt;br&gt;actuator (safety cut-off)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="210" height="90" as="geometry"/></mxCell><mxCell id="sys7" value="&lt;b&gt;Water model&lt;/b&gt;&lt;br&gt;T += 0.5 P/100 - 0.005 (T-20)&lt;br&gt;P = heater % if relay closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="460" height="90" as="geometry"/></mxCell><mxCell id="sys8" value="&lt;b&gt;T sensor&lt;/b&gt;&lt;br&gt;sends round(T), FF = broken" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="410" width="210" height="90" as="geometry"/></mxCell><mxCell id="sys9" value="power" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sys5" target="sys7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys10" value="supply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sys6" target="sys7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys11" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sys7" target="sys8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys12" value="&lt;b&gt;STM32F407  -  apk9.c&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;= the BRAIN&lt;br&gt;&lt;br&gt;reads the sensor&lt;br&gt;decides heater + relay&lt;br&gt;NORMAL / SAFE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="400" height="380" as="geometry"/></mxCell><mxCell id="sys13" value="Control Relay &amp; Heater&lt;br&gt;AA 72 PP  /  AA 73 RR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#0C8599;fontColor=#0C8599;" edge="1" parent="1" source="sys12" target="sys6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="175"/></Array></mxGeometry></mxCell><mxCell id="sys14" value="Get Sensor&lt;br&gt;AA 60 TT every 100 ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;fontColor=#9673A6;" edge="1" parent="1" source="sys8" target="sys12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="455"/></Array></mxGeometry></mxCell><mxCell id="sys15" value="&lt;b&gt;SAFETY GOAL&lt;/b&gt;: never heat above 95 C or with an unknown temperature.  Detection 90 C, hazard 95 C." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1180" height="50" as="geometry"/></mxCell><mxCell id="sys16" value="water heats only if heater ON AND relay closed" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="520" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="SW Architecture" id="SW_Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sw 3" value="APK9 - SW architecture: 3 tasks, 1 job each, 1 output writer" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="sw 4" value="Legend: yellow dashed = interrupt  |  blue = task  |  red = supervisor  |  green = RTOS object  |  purple = shared variable  |  orange = output" style="text;html=1;fontSize=11;fontFamily=Arial;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1250" height="24" as="geometry"/></mxCell><mxCell id="sw 5" value="&lt;b&gt;USART2 RX ISR&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;HAL_UART_RxCpltCallback&lt;br&gt;WAIT_SOF / CMD / DATA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="90" as="geometry"/></mxCell><mxCell id="sw 6" value="&lt;b&gt;QueueFrame&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;8 x Frame_t&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;direction=south;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="115" width="170" height="80" as="geometry"/></mxCell><mxCell id="sw 7" value="&lt;b&gt;LinkLayer  (prio 3, on frame)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;SENSOR_TEMP -&gt; SensorValue, Tick, Seen&lt;br&gt;RESET_REQ -&gt; ResetRequest&lt;br&gt;INJECT_FAULT -&gt; InjectDeadlock&lt;br&gt;GET_MODE / PING -&gt; answer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="330" height="130" as="geometry"/></mxCell><mxCell id="sw 8" value="xQueueSendFromISR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sw 5" target="sw 6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sw 9" value="xQueueReceive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sw 6" target="sw 7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sw 10" value="&lt;b&gt;Shared variables (one writer each)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SensorValue, SensorTick, SensorSeen  &amp;lt;- LinkLayer&lt;br&gt;ResetRequest, InjectDeadlock  &amp;lt;- LinkLayer&lt;br&gt;PowerRequest, ControlAlive  &amp;lt;- ControlTask&lt;br&gt;Mode  &amp;lt;- SafetyTask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="940" y="90" width="360" height="130" as="geometry"/></mxCell><mxCell id="sw 11" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sw 7" target="sw 10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sw 12" value="&lt;b&gt;ControlTask  (prio 2, 100 ms)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;the FUNCTION&lt;br&gt;ControlAlive++&lt;br&gt;thermostat: &lt;=38 C -&gt; 100, &gt;=40 C -&gt; 0&lt;br&gt;writes PowerRequest&lt;br&gt;&lt;b&gt;never writes an output&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="140" y="330" width="360" height="160" as="geometry"/></mxCell><mxCell id="sw 13" value="&lt;b&gt;SafetyTask  (prio 4, 50 ms)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;the SUPERVISOR&lt;br&gt;CheckErrors(): 4 errors&lt;br&gt;switch (Mode): NORMAL / SAFE&lt;br&gt;reset check&lt;br&gt;&lt;b&gt;WriteOutputs(): ONLY output writer&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FDE9E7;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="400" height="160" as="geometry"/></mxCell><mxCell id="sw 14" value="SensorValue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="sw 10" target="sw 12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="280"/><mxPoint x="320" y="280"/></Array></mxGeometry></mxCell><mxCell id="sw 15" value="all variables" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="sw 10" target="sw 13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="280"/><mxPoint x="1200" y="410"/></Array></mxGeometry></mxCell><mxCell id="sw 16" value="PowerRequest&lt;br&gt;ControlAlive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sw 12" target="sw 13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sw 17" value="&lt;b&gt;Heater&lt;/b&gt;&lt;br&gt;LED PD15 + EVT_HEATER&lt;br&gt;AA 72 PP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="590" width="250" height="90" as="geometry"/></mxCell><mxCell id="sw 18" value="&lt;b&gt;Safety relay&lt;/b&gt;&lt;br&gt;EVT_RELAY&lt;br&gt;AA 73 RR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="920" y="590" width="250" height="90" as="geometry"/></mxCell><mxCell id="sw 19" value="WriteOutputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#C62828;fontColor=#C62828;" edge="1" parent="1" source="sw 13" target="sw 17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sw 20" value="WriteOutputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#C62828;fontColor=#C62828;" edge="1" parent="1" source="sw 13" target="sw 18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sw 21" value="&lt;b&gt;SendFrame(cmd, data)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;take xUartMutex&lt;br&gt;HAL_UART_Transmit 3 bytes&lt;br&gt;give xUartMutex&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="140" y="590" width="300" height="100" as="geometry"/></mxCell><mxCell id="sw 22" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="sw 13" target="sw 21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="540"/><mxPoint x="290" y="540"/></Array></mxGeometry></mxCell><mxCell id="sw 23" value="answers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="sw 7" target="sw 21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="155"/><mxPoint x="60" y="640"/></Array></mxGeometry></mxCell><mxCell id="sw 24" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;1. one task = one job&lt;br&gt;2. one writer per variable (no mutex needed)&lt;br&gt;3. only the supervisor writes the outputs&lt;br&gt;4. the supervisor has the highest priority&lt;br&gt;5. the function knows nothing about safety" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="140" y="740" width="560" height="150" as="geometry"/></mxCell><mxCell id="sw 25" value="&lt;b&gt;Tasks&lt;/b&gt;&lt;br&gt;SafetyTask prio 4, 50 ms&lt;br&gt;LinkLayer prio 3, event&lt;br&gt;ControlTask prio 2, 100 ms" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="740" width="300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Modes" id="Modes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mod3" value="APK9 - Two modes, owned by the SafetyTask" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="mod4" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="100" width="30" height="30" as="geometry"/></mxCell><mxCell id="mod5" value="&lt;b style='font-size:20px'&gt;NORMAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;heater = PowerRequest&lt;br&gt;relay CLOSED&lt;br&gt;green LED PD12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontFamily=Arial;fontSize=14;fillColor=#D5E8D4;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="260" height="170" as="geometry"/></mxCell><mxCell id="mod6" value="&lt;b style='font-size:20px;color:#C62828'&gt;SAFE&lt;/b&gt;&lt;br&gt;&lt;br&gt;heater OFF&lt;br&gt;relay OPEN&lt;br&gt;red LED PD14, wait for RESET" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontFamily=Arial;fontSize=14;fillColor=#F8CECC;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="280" height="170" as="geometry"/></mxCell><mxCell id="mod7" value="boot / EVT_BOOT, EVT_MODE 00" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mod4" target="mod5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mod8" value="ANY error (err != 0)&lt;br&gt;/ heater 0, relay OPEN first,&lt;br&gt;then EVT_MODE 01, EVT_ERROR err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#C62828;fontColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="mod5" target="mod6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="240"/></Array></mxGeometry></mxCell><mxCell id="mod9" value="RESET_REQ [SensorSeen, sample &amp;lt; 500 ms, T &amp;lt; 60 C]&lt;br&gt;/ answer E2 00, NVIC_SystemReset()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;fontColor=#1565C0;dashed=1;" edge="1" parent="1" source="mod6" target="mod5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="330"/></Array></mxGeometry></mxCell><mxCell id="mod10" value="RESET_REQ refused / E2 E6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="mod6" target="mod6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="440"/><mxPoint x="1020" y="440"/></Array></mxGeometry></mxCell><mxCell id="mod11" value="&lt;b&gt;Errors -&gt; SAFE&lt;/b&gt;&lt;br&gt;01 ERR_SENSOR: SensorValue &amp;gt; 120 (FF)&lt;br&gt;02 ERR_TIMEOUT: no sample 500 ms&lt;br&gt;04 ERR_OVERTEMP: SensorValue &amp;gt; 90 C&lt;br&gt;08 ERR_ALIVE: ControlAlive unchanged 300 ms" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="460" height="140" as="geometry"/></mxCell><mxCell id="mod12" value="&lt;b&gt;Why a reboot?&lt;/b&gt;&lt;br&gt;after a deadlock the ControlTask is dead:&lt;br&gt;only a restart brings it back.&lt;br&gt;&lt;b&gt;Why T &amp;lt; 60 C?&lt;/b&gt;&lt;br&gt;never restart on hot water." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="400" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Detailed Design" id="Detailed_Design"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="det3" value="APK9 - Detailed design: ControlTask and SafetyTask loops" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="det4" value="ControlTask (100 ms)" style="text;html=1;fontStyle=1;fontColor=#1565C0;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="300" height="24" as="geometry"/></mxCell><mxCell id="det5" value="vTaskDelayUntil(100 ms)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="300" height="50" as="geometry"/></mxCell><mxCell id="det6" value="ControlAlive++" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="300" height="50" as="geometry"/></mxCell><mxCell id="det7" value="InjectDeadlock ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="300" height="80" as="geometry"/></mxCell><mxCell id="det8" value="xSemaphoreTake(never given)&lt;br&gt;blocked forever" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fillColor=#F8CECC;" vertex="1" parent="1"><mxGeometry x="420" y="285" width="220" height="50" as="geometry"/></mxCell><mxCell id="det9" value="t = SensorValue&lt;br&gt;t &amp;gt; 120 -&amp;gt; 0&lt;br&gt;t &amp;lt;= 38 -&amp;gt; 100&lt;br&gt;t &amp;gt;= 40 -&amp;gt; 0&lt;br&gt;else keep" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="300" height="110" as="geometry"/></mxCell><mxCell id="det10" value="PowerRequest = power" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fillColor=#FFE6CC;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="300" height="50" as="geometry"/></mxCell><mxCell id="det11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det5" target="det6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det6" target="det7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det9" target="det10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det7" target="det8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det7" target="det9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det16" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#999999;" edge="1" parent="1" source="det10" target="det5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="545"/><mxPoint x="30" y="135"/></Array></mxGeometry></mxCell><mxCell id="det17" value="SafetyTask (50 ms)" style="text;html=1;fontStyle=1;fontColor=#C62828;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="300" height="24" as="geometry"/></mxCell><mxCell id="det18" value="vTaskDelayUntil(50 ms)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="360" height="50" as="geometry"/></mxCell><mxCell id="det19" value="err = CheckErrors()&lt;br&gt;SensorValue &amp;gt; 120 -&amp;gt; 01&lt;br&gt;SensorValue &amp;gt; 90 -&amp;gt; 04&lt;br&gt;now - SensorTick &amp;gt; 500 ms -&amp;gt; 02&lt;br&gt;ControlAlive same 300 ms -&amp;gt; 08" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;strokeColor=#C62828;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="360" height="120" as="geometry"/></mxCell><mxCell id="det20" value="Mode ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="760" y="340" width="360" height="70" as="geometry"/></mxCell><mxCell id="det21" value="&lt;b&gt;NORMAL&lt;/b&gt;&lt;br&gt;err == 0: WriteOutputs(PowerRequest, 1)&lt;br&gt;err != 0: Mode = SAFE,&lt;br&gt;WriteOutputs(0, 0),&lt;br&gt;EVT_MODE 01, EVT_ERROR err" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fillColor=#D5E8D4;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="290" height="130" as="geometry"/></mxCell><mxCell id="det22" value="&lt;b&gt;SAFE&lt;/b&gt;&lt;br&gt;WriteOutputs(0, 0)&lt;br&gt;ResetRequest ?&lt;br&gt;fresh, valid, &amp;lt; 60 C: E2 00, reboot&lt;br&gt;else E2 E6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fillColor=#F8CECC;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="450" width="290" height="130" as="geometry"/></mxCell><mxCell id="det23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det18" target="det19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det19" target="det20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det25" value="NORMAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det20" target="det21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det26" value="SAFE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="det20" target="det22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det27" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#999999;" edge="1" parent="1" source="det21" target="det18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="515"/><mxPoint x="610" y="135"/></Array></mxGeometry></mxCell><mxCell id="det28" value="&lt;b&gt;WriteOutputs(power, relay)&lt;/b&gt; - the ONLY output writer&lt;br&gt;LED PD15 = power &amp;gt; 0&lt;br&gt;power changed -&amp;gt; EVT_HEATER (AA 72 PP)&lt;br&gt;relay changed -&amp;gt; EVT_RELAY (AA 73 RR)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="610" height="100" as="geometry"/></mxCell><mxCell id="det29" value="&lt;b&gt;LinkLayer&lt;/b&gt; (on each frame): 60 -&amp;gt; SensorValue, SensorTick, SensorSeen (no answer) | 62 -&amp;gt; ResetRequest or E6 | 63 -&amp;gt; InjectDeadlock, 00 | 64 -&amp;gt; mode | 01 -&amp;gt; echo | other -&amp;gt; E1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1190" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Sequence Heater Stuck" id="Sequence_Heater_Stuck"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq3" value="APK9 - Sequence: normal regulation, heater stuck ON, SAFE, reset" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;vert