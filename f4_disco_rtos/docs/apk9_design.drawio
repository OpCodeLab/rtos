rcePoint"/><mxPoint x="420" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq10" value="PowerRequest = 100" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="200" as="sourcePoint"/><mxPoint x="960" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq11" value="heater ON" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="240" as="sourcePoint"/><mxPoint x="1230" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq12" value="AA 72 64" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="270" as="sourcePoint"/><mxPoint x="150" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq13" value="AA 60 28  (T = 40 C)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="330" as="sourcePoint"/><mxPoint x="420" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq14" value="AA 72 00  heater OFF" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="370" as="sourcePoint"/><mxPoint x="150" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq15" value="FAULT: heater stuck ON -&amp;gt; T rises" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="158" y="400" width="230" height="30" as="geometry"/></mxCell><mxCell id="seq16" value="AA 60 5B  (T = 91 C)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="470" as="sourcePoint"/><mxPoint x="420" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq17" value="CheckErrors: 91 &amp;gt; 90 -&amp;gt; ERR_OVERTEMP" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="968" y="490" width="250" height="30" as="geometry"/></mxCell><mxCell id="seq18" value="heater OFF, relay OPEN" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;strokeColor=#C62828;fontColor=#C62828;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="550" as="sourcePoint"/><mxPoint x="1230" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq19" value="AA 72 00, AA 73 00, AA 70 01, AA 71 04" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;strokeColor=#C62828;fontColor=#C62828;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="590" as="sourcePoint"/><mxPoint x="150" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq20" value="relay open: no power -&amp;gt; T falls" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="158" y="610" width="220" height="30" as="geometry"/></mxCell><mxCell id="seq21" value="AA 62 00 at 85 C" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="680" as="sourcePoint"/><mxPoint x="420" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq22" value="AA E2 E6  refused" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontFamily=Ar