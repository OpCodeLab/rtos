<mxfile host="app.diagrams.net" agent="APK7 generator" version="24.7.0"><diagram name="Architecture" id="Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arc3" value="APK7 - Button 1 AND Button 2 -&gt; 5 s timer (event group + software timer)" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="arc4" value="Legend: purple = PC &amp;nbsp;|&amp;nbsp; yellow dashed = interrupt &amp;nbsp;|&amp;nbsp; blue = task &amp;nbsp;|&amp;nbsp; orange = timer service task &amp;nbsp;|&amp;nbsp; green = RTOS object &amp;nbsp;|&amp;nbsp; grey = hardware &amp;nbsp;|&amp;nbsp; grey box = reused from APK5" style="text;html=1;fontSize=11;fontFamily=Arial;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1200" height="24" as="geometry"/></mxCell><mxCell id="arc5" value="PC - tools/apk7_gui.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1220" height="150" as="geometry"/></mxCell><mxCell id="arc6" value="&lt;b&gt;MainWindow&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;BUTTON 1 / BUTTON 2 / PING&lt;br&gt;lamps EV_BUTTON_1, EV_BUTTON_2, TIMER&lt;br&gt;countdown, log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="330" height="90" as="geometry"/></mxCell><mxCell id="arc7" value="&lt;b&gt;pyserial COM port  |  SimBoard&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;115200 8N1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="320" height="70" as="geometry"/></mxCell><mxCell id="arc8" value="AA 40 00 / AA 41 00" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1" source="arc6" target="arc7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc9" value="STM32F407 Discovery - Core/Src/apk7.c" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1220" height="570" as="geometry"/></mxCell><mxCell id="arc10" value="APK5 link layer (unchanged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontFamily=Arial;fontSize=11;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="1180" height="150" as="geometry"/></mxCell><mxCell id="arc11" value="&lt;b&gt;USART2 + RX ISR&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;WAIT_SOF / CMD / DATA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="920" y="370" width="280" height="80" as="geometry"/></mxCell><mxCell id="arc12" value="&lt;b&gt;QueueFrame&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;direction=south;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="375" width="160" height="70" as="geometry"/></mxCell><mxCell id="arc13" value="&lt;b&gt;SendFrame()&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;xUartMutex&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="90" y="370" width="240" height="80" as="geometry"/></mxCell><mxCell id="arc14" value="&lt;b&gt;LinkLayer task  (prio 3)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;BUTTON_1: set EV_BUTTON_1, PD12 on&lt;br&gt;BUTTON_2: set EV_BUTTON_2, PD13 on&lt;br&gt;answer AA C0/C1 00&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="300" height="100" as="geometry"/></mxCell><mxCell id="arc15" value="&lt;b&gt;EgButtons (event group)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;bit 0 EV_BUTTON_1&lt;br&gt;bit 1 EV_BUTTON_2&lt;br&gt;bit 2 EV_TIMEOUT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="260" height="100" as="geometry"/></mxCell><mxCell id="arc16" value="&lt;b&gt;AppTask  (prio 2)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;1. wait BUTTON_1 AND BUTTON_2 (clear)&lt;br&gt;2. PD15 on, start tApp, EVT_TIMER_STARTED&lt;br&gt;3. wait EV_TIMEOUT (clear)&lt;br&gt;4. PD15 off, EVT_TIMER_EXPIRED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="300" height="130" as="geometry"/></mxCell><mxCell id="arc17" value="&lt;b&gt;tApp  one-shot 5 s&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;AppTimerCallback()&lt;br&gt;set EV_TIMEOUT (never blocks)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="820" y="720" width="260" height="90" as="geometry"/></mxCell><mxCell id="arc18" value="UART" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;dashed=1;" edge="1" parent="1" source="arc7" target="arc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc19" value="xQueueSendFromISR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc11" target="arc12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc20" value="xQueueReceive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc12" target="arc14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="570"/></Array></mxGeometry></mxCell><mxCell id="arc21" value="xEventGroupSetBits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc14" target="arc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc22" value="xEventGroupWaitBits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc15" target="arc16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="670"/><mxPoint x="530" y="670"/></Array></mxGeometry></mxCell><mxCell id="arc23" value="xTimerStart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc16" target="arc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc24" value="xEventGroupSetBits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc17" target="arc15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="765"/><mxPoint x="1150" y="570"/></Array></mxGeometry></mxCell><mxCell id="arc25" value="responses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc14" target="arc13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="570"/></Array></mxGeometry></mxCell><mxCell id="arc26" value="EVT_TIMER_x" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="arc16" target="arc13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="765"/><mxPoint x="160" y="450"/></Array></mxGeometry></mxCell><mxCell id="arc27" value="HAL_UART_Transmit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc13" target="arc11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="360"/><mxPoint x="1060" y="360"/></Array></mxGeometry></mxCell><mxCell id="arc28" value="New in APK7 = bold boxes and the event group / timer" style="text;html=1;fontSize=11;fontFamily=Arial;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="500" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="AppTask Flow" id="AppTask_Flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="app3" value="AppTask - flowchart (what the student writes)" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="app4" value="&lt;b&gt;TODO 6&lt;/b&gt;&lt;br&gt;xEventGroupWaitBits(EgButtons,&lt;br&gt;EV_BUTTON_1 | EV_BUTTON_2,&lt;br&gt;clear = pdTRUE, all = pdTRUE, portMAX_DELAY)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="340" height="90" as="geometry"/></mxCell><mxCell id="app5" value="PD12, PD13 off  -  PD15 on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="340" height="40" as="geometry"/></mxCell><mxCell id="app6" value="&lt;b&gt;TODO 7&lt;/b&gt;&lt;br&gt;xTimerStart(tApp, 0)" style="