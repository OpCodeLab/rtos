ll id="0"/><mxCell id="1" parent="0"/><mxCell id="sta3" value="SystemTask and SensorTask state machines" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="sta4" value="SystemTask (prio 2) - writes SysState" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#3A5FCD;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="600" height="24" as="geometry"/></mxCell><mxCell id="sta5" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="165" y="115" width="30" height="30" as="geometry"/></mxCell><mxCell id="sta6" value="IDLE_STATE&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;wait for configuration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontFamily=Arial;fontSize=14;fontStyle=1;fillColor=#ECEFF1;strokeColor=#607D8B;" vertex="1" parent="1"><mxGeometry x="90" y="220" width="180" height="80" as="geometry"/></mxCell><mxCell id="sta7" value="READY_STATE&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;config valid, wait for START&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontFamily=Arial;fontSize=14;fontStyle=1;fillColor=#FFF9C4;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="540" y="220" width="200" height="80" as="geometry"/></mxCell><mxCell id="sta8" value="RUN_STATE&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;RunCycle(): 6 steps x 10 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontFamily=Arial;fontSize=14;fontStyle=1;fillColor=#C8E6C9;strokeColor=#388E3C;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="200" height="80" as="geometry"/></mxCell><mxCell id="sta9" value="reset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sta5" target="sta6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sta10" value="CFG_x and config complete&lt;br&gt;/ answer OK, orange LED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sta6" target="sta7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sta11" value="START [SensorState = NO_ERROR]&lt;br&gt;/ answer OK, EVT_STEP 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sta7" target="sta8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sta12" value="end of step 6&lt;br&gt;/ blue LED, EVT_DONE (config kept)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sta8" target="sta7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="380"/><mxPoint x="640" y="380"/></Array></mxGeometry></mxCell><mxCell id="sta13" value="CFG_x / store, OK or E2&lt;br&gt;START / E4 NOT_CONFIGURED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="sta6" target="sta6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="330"/><mxPoint x="40" y="200"/></Array></mxGeometry></mxCell><mxCell id="sta14" value="CFG_x / replace value, OK or E2&lt;br&gt;START [SensorState = ERROR] / E5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="sta7" target="sta7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="170"/><mxPoint x="700" y="170"/></Array></mxGeometry></mxCell><mxCell id="sta15" value="100 ms tick / EVT_PROGRESS every 200 ms&lt;br&gt;step end / EVT_STEP n+1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="sta8" target="sta8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="330"/><mxPoint x="1250" y="200"/></Array></mxGeometry></mxCell><mxCell id="sta16" value="&lt;b&gt;In RUN_STATE&lt;/b&gt; the LinkLayer answers CFG_x and START with &lt;b&gt;E3 BUSY&lt;/b&gt; without forwarding them (also while the SystemTask is suspended). Time is counted in executed 100 ms ticks, so a suspension freezes the step." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="540" y="420" width="660" height="60" as="geometry"/></mxCell><mxCell id="sta17" value="SensorTask (prio 4) - writes SensorState" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#B85450;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="600" height="24" as="geometry"/></mxCell><mxCell id="sta18" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="165" y="605" width="30" height="30" as="geometry"/></mxCell><mxCell id="sta19" value="NO_ERROR_STATE&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;door closed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontFamily=Arial;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="90" y="710" width="180" height="80" as="geometry"/></mxCell><mxCell id="sta20" value="ERROR_STATE&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal'&gt;door open&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontFamily=Arial;fontSize=14;fontStyle=1;fillColor=#FFCDD2;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="640" y="710" width="180" height="80" as="geometry"/></mxCell><mxCell id="sta21" value="reset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sta18" target="sta19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sta22" value="B1 press / red LED on, take xUartMutex,&lt;br&gt;[SysState = RUN] vTaskSuspend(SystemTask),&lt;br&gt;give mutex, EVT_DOOR 1, [suspended] EVT_ERROR 0x01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;fontColor=#B85450;dashed=1;strokeWidth=2;" edge="1" parent="1" source="sta19" target="sta20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="680"/><mxPoint x="730" y="680"/></Array></mxGeometry></mxCell><mxCell id="sta23" value="B1 press / red LED off, EVT_DOOR 0,&lt;br&gt;[suspended] vTaskResume(SystemTask)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#388E3C;fontColor=#388E3C;" edge="1" parent="1" source="sta20" target="sta19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="840"/><mxPoint x="180" y="840"/></Array></mxGeometry></mxCell><mxCell id="sta24" value="&lt;b&gt;B1 press&lt;/b&gt; = WaitButtonPress(): SemDoor from EXTI0, wait 30 ms, PA0 still high, then wait for release + 30 ms and drop the bounce edges.&lt;br&gt;&lt;b&gt;suspended&lt;/b&gt; = local flag of the SensorTask: it only resumes what it suspended." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="400" height="110" as="geometry"/></mxCell><mxCell id="sta25" value="&lt;b&gt;GET_STATUS&lt;/b&gt; answer DATA = SysState (0 IDLE, 1 READY, 2 RUN) | 0x80 if SensorState = ERROR_STATE" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="900" width="730" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="LinkLayer Routing" id="LinkLayer_Routing"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lin3" value="LinkLayer task - frame routing" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="lin4" value="xQueueReceive(QueueFrame, portMAX_DELAY)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="80" width="300" height="50" as="geometry"/></mxCell><mxCell id="lin5" value="LOG_INFO RX frame" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="160" width="200" height="40" as="geometry"/></mxCell><mxCell id="lin6" value="CMD ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175" y="230" width="150" height="90" as="geometry"/></mxCell><mxCell id="lin7" value="PING: answer echo&lt;br&gt;GET_STATUS: ans