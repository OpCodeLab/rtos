oint x="1060" y="275"/></Array></mxGeometry></mxCell><mxCell id="arc12" value="STM32F407 Discovery - Core/Src/apk6.c (FreeRTOS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1200" height="720" as="geometry"/></mxCell><mxCell id="arc13" value="&lt;b&gt;SendFrame()&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;SWC-TX&lt;br&gt;called by LinkLayer, SystemTask,&lt;br&gt;SensorTask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="90" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="arc14" value="&lt;b&gt;xUartMutex&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;shared with printf / _write()&lt;br&gt;taken by SensorTask before suspend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="520" y="410" width="240" height="100" as="geometry"/></mxCell><mxCell id="arc15" value="&lt;b&gt;USART2 + IRQ&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;PA2 / PA3, NVIC priority 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="930" y="410" width="260" height="100" as="geometry"/></mxCell><mxCell id="arc16" value="&lt;b&gt;LinkLayer task  (prio 3)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;SWC-LL&lt;br&gt;PING, GET_STATUS answered here&lt;br&gt;RUN_STATE: CFG + START -&gt; E3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="90" y="580" width="260" height="110" as="geometry"/></mxCell><mxCell id="arc17" value="&lt;b&gt;QueueFrame&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;8 x Frame_t&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;direction=south;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="590" width="180" height="90" as="geometry"/></mxCell><mxCell id="arc18" value="&lt;b&gt;HAL_UART_RxCpltCallback&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;SWC-ISR, RX state machine&lt;br&gt;50 ms inter-byte timeout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="930" y="580" width="260" height="110" as="geometry"/></mxCell><mxCell id="arc19" value="&lt;b&gt;QueueCmd&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;4 x Frame_t&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;direction=south;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="750" width="180" height="80" as="geometry"/></mxCell><mxCell id="arc20" value="&lt;b&gt;GPIO LEDs&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;PD12 green: running&lt;br&gt;PD13 orange: configured&lt;br&gt;PD14 red: door open  PD15 blue: done&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="740" width="240" height="100" as="geometry"/></mxCell><mxCell id="arc21" value="&lt;b&gt;User button B1 (PA0)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;simulates the door switch&lt;br&gt;EXTI0 rising edge, priority 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="930" y="740" width="260" height="100" as="geometry"/></mxCell><mxCell id="arc22" value="&lt;b&gt;SystemTask  (prio 2)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;SWC-SYS  -  writes SysState&lt;br&gt;IDLE_STATE: wait for configuration&lt;br&gt;READY_STATE: wait for START&lt;br&gt;RUN_STATE: 6 x 10 s, EVT_STEP / PROGRESS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#D0E0FF;strokeColor=#3A5FCD;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="900" width="260" height="130" as="geometry"/></mxCell><mxCell id="arc23" value="&lt;b&gt;SensorTask  (prio 4)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;SWC-SEN  -  writes SensorState&lt;br&gt;NO_ERROR_STATE: door closed&lt;br&gt;ERROR_STATE: door open&lt;br&gt;suspend / resume SystemTask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="520" y="900" width="240" height="130" as="geometry"/></mxCell><mxCell id="arc24" value="&lt;b&gt;HAL_GPIO_EXTI_Callback&lt;/b&gt;&lt;br&gt;&lt;font color='#555555' style='font-size:11px'&gt;xSemaphoreGiveFromISR(SemDoor)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="930" y="920" width="260" height="90" as="geometry"/></mxCell><mxCell id="arc25" value="UART  AA | CMD | DATA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;dashed=1;" edge="1" parent="1" source="arc8" target="arc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc26" value="1 byte / IRQ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc15" target="arc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc27" value="xQueueSendFromISR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc18" target="arc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc28" value="xQueueReceive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc17" target="arc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc29" value="forward (IDLE only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc16" target="arc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc30" value="xQueueReceive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc19" target="arc22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc31" value="responses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc16" target="arc13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc32" value="take / give" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc13" target="arc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc33" value="HAL_UART_Transmit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc14" target="arc15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc34" value="rising edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc21" target="arc24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc35" value="SemDoor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="arc24" target="arc23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arc36" value="vTaskSuspend / vTaskResume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Arial;fontSize=11;label